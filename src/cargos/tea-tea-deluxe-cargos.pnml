        unit_name: string(STR_CARGO_SINGULAR_TEA);
        units_of_cargo: TTD_STR_CRATES;
        items_of_cargo: string(STR_QUANTITY_TEA);
        type_abbreviation: string(STR_ABBREV_TEA);
        weight: 0.35;
        is_freight: 1;
        cargo_classes: bitmask(CC_PIECE_GOODS);
        station_list_colour: ARRAY_EVAL(CARGO_COLOR_INDEX, TEAB_INDEX);
        cargo_payment_list_colour: ARRAY_EVAL(CARGO_COLOR_INDEX, TEAB_INDEX);
        capacity_multiplier: 2;
        town_growth_multiplier: TOWNGROWTH_NONE;
        price_factor: 155;
        penalty_lowerbound: 15;
        single_penalty_length: 100;
        sprite: NEW_CARGO_SPRITE;
    }
    graphics {
        default: cargoicon_tea_boxes;
    }
}
