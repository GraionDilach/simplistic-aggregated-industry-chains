spriteset(cargoicon_tea_leaves) {
    [0, 0, "gfx/cargo_icons/teal.png"]
}

item(FEAT_CARGOS, cargo_tea_leaves, TEAL_INDEX) {
    property {
        number: TEAL_INDEX;
        cargo_label: "TEAL";
        type_name: string(STR_CARGO_PLURAL_TEA_LEAVES);
        unit_name: string(STR_CARGO_SINGULAR_TEA_LEAVES);
        units_of_cargo: TTD_STR_CRATES;
        items_of_cargo: string(STR_QUANTITY_TEA_LEAVES);
        type_abbreviation: string(STR_ABBREV_TEA_LEAVES);
        weight: 0.35;
        is_freight: 1;
        cargo_classes: bitmask(CC_PIECE_GOODS);
        station_list_colour: ARRAY_EVAL(CARGO_COLOR_INDEX, TEAL_INDEX);
        cargo_payment_list_colour: ARRAY_EVAL(CARGO_COLOR_INDEX, TEAL_INDEX);
        capacity_multiplier: 2;
        town_growth_multiplier: TOWNGROWTH_NONE;
        price_factor: 150;
        penalty_lowerbound: 0;
        single_penalty_length: 0;
        sprite: NEW_CARGO_SPRITE;
    }
    graphics {
        default: cargoicon_tea_leaves;
    }
}

spriteset(cargoicon_tea_boxes) {
