item(FEAT_CARGOS, cargo_sugar, SUGR_INDEX) {
    property {
        number: SUGR_INDEX;
        type_name: TTD_STR_CARGO_PLURAL_SUGAR;
        unit_name: TTD_STR_CARGO_SINGULAR_SUGAR;
        units_of_cargo: TTD_STR_TONS;
        items_of_cargo: TTD_STR_QUANTITY_SUGAR;
        type_abbreviation: TTD_STR_ABBREV_SUGAR;
        sprite: NEW_CARGO_SPRITE;
        weight: 1;
        station_list_colour: ARRAY_EVAL(CARGO_COLOR_INDEX, SUGR_INDEX);
        cargo_payment_list_colour: ARRAY_EVAL(CARGO_COLOR_INDEX, SUGR_INDEX);
        is_freight: 1;
        cargo_classes: bitmask(CC_POWDER_BULK, CC_PIECE_GOODS, CC_POTABLE);
        cargo_label: "SUGR";
        town_growth_effect: TOWNGROWTH_NONE;
        town_growth_multiplier: 0;
        penalty_lowerbound: 20;
        single_penalty_length: 255;
        price_factor: CONVERT_PRICE_FACTOR(4437); //107.90
        capacity_multiplier: 1;
    }
    graphics {
        cargoicon_sugar;
    }
}

