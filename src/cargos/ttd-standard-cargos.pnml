#define CONVERT_PRICE_FACTOR(number) \
	(number * 10.0 * 20 * 255) / (1 << 21)

// number * 51000 / 2097152

spriteset(cargoicon_passenger) {
    [0, 0, "gfx/cargo_icons/pass.png"]
}

item(FEAT_CARGOS, cargo_passenger, PASS_INDEX) {
    property {
        type_name: TTD_STR_CARGO_PLURAL_PASSENGERS;
        unit_name: TTD_STR_CARGO_SINGULAR_PASSENGER;
        units_of_cargo: TTD_STR_PASSENGERS;
        items_of_cargo: TTD_STR_QUANTITY_PASSENGERS;
        type_abbreviation: TTD_STR_ABBREV_PASSENGERS;
        sprite: NEW_CARGO_SPRITE;
        weight: 0.0625; // 1/16
        station_list_colour: ARRAY_EVAL(CARGO_COLOR_INDEX, PASS_INDEX);
        cargo_payment_list_colour: ARRAY_EVAL(CARGO_COLOR_INDEX, PASS_INDEX);
        is_freight: 0;
        cargo_classes: bitmask(CC_PASSENGERS);
        cargo_label: "PASS";
        town_growth_effect: TOWNGROWTH_PASSENGERS;
        town_growth_multiplier: 1;
        penalty_lowerbound: 0;
        single_penalty_length: 24;
        price_factor: CONVERT_PRICE_FACTOR(3185);
        capacity_multiplier: 4;
        number: PASS_INDEX;
    }
    graphics {
        cargoicon_passenger;
    }
}

