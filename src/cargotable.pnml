cargotable
{
	// default TTD cargos
	PASS, COAL, MAIL, OIL_,
	LVST, GOOD, GRAI, WOOD,
	IORE, WATR, VALU, FOOD,
	STEL, CORE, FRUT, DIAM,
	PAPR, GOLD, RUBR,

	#define PASS_INDEX    0             // FIXED TTD & ECS
	#define COAL_INDEX    FREE_INDEX_00
	#define MAIL_INDEX    2             // FIXED TTD & ECS
	#define OIL__INDEX    FREE_INDEX_01
	#define LVST_INDEX    FREE_INDEX_02
	#define GOOD_INDEX    5             // FIXED TTD & ECS
	#define GRAI_INDEX    FREE_INDEX_03 // WHEA, MAIZ, CERE
	#define WOOD_INDEX    FREE_INDEX_04
	#define IORE_INDEX    FREE_INDEX_05
	#define WATR_INDEX    27            // FIXED ECS (TTD #9)
	#define VALU_INDEX    10            // FIXED TTD & ECS
	#define FOOD_INDEX    11            // FIXED TTD & ECS
	#define STEL_INDEX    FREE_INDEX_06
	#define CORE_INDEX    FREE_INDEX_07
	#define FRUT_INDEX    FREE_INDEX_08
	#define DIAM_INDEX    FREE_INDEX_09
	#define PAPR_INDEX    FREE_INDEX_10
	#define GOLD_INDEX    FREE_INDEX_11
	#define RUBR_INDEX    FREE_INDEX_12

	// Toyland cargos
	SUGR, TOYS, BATT, SWET,
	TOFF, COLA, CTCD, BUBL,
	PLST, FZDR

	#define SUGR_INDEX    FREE_INDEX_13
	#define TOYS_INDEX    FREE_INDEX_14
