#define INDUSTRYTILE_RECOLOR_BLOCK(spritelayout)                                                 \
switch (FEAT_INDUSTRYTILES, PARENT, spritelayout##_random_company_color, random_bits % 29) {     \
    0: return spritelayout##_PALETTE_OLDCC_DARK_BLUE;                                            \
    1: return spritelayout##_PALETTE_OLDCC_PALE_GREEN;                                           \
    2: return spritelayout##_PALETTE_OLDCC_PINK;                                                 \
    3: return spritelayout##_PALETTE_OLDCC_YELLOW;                                               \
    4: return spritelayout##_PALETTE_OLDCC_RED;                                                  \
    5: return spritelayout##_PALETTE_OLDCC_LIGHT_BLUE;                                           \
    6: return spritelayout##_PALETTE_OLDCC_GREEN;                                                \
    7: return spritelayout##_PALETTE_OLDCC_DARK_GREEN;                                           \
    8: return spritelayout##_PALETTE_OLDCC_BLUE;                                                 \
    9: return spritelayout##_PALETTE_OLDCC_CREAM;                                                \
   10: return spritelayout##_PALETTE_OLDCC_MAUVE;                                                \
   11: return spritelayout##_PALETTE_OLDCC_PURPLE;                                               \
   12: return spritelayout##_PALETTE_OLDCC_ORANGE;                                               \
   13: return spritelayout##_PALETTE_OLDCC_BROWN;                                                \
   14: return spritelayout##_PALETTE_OLDCC_GREY;                                                 \
   15: return spritelayout##_PALETTE_OLDCC_WHITE;                                                \
   16: return spritelayout##_PALETTE_NEWCC_BRIGHT_DARK_BLUE;                                     \
   17: return spritelayout##_PALETTE_NEWCC_BRIGHT_PINK;                                          \
   18: return spritelayout##_PALETTE_NEWCC_BRIGHT_YELLOW;                                        \
   19: return spritelayout##_PALETTE_NEWCC_BRIGHT_RED;                                           \
   20: return spritelayout##_PALETTE_NEWCC_BRIGHT_DARK_GREEN;                                    \
   21: return spritelayout##_PALETTE_NEWCC_BRIGHT_BLACK;                                         \
   22: return spritelayout##_PALETTE_NEWCC_BRIGHT_CREAM;                                         \
   23: return spritelayout##_PALETTE_NEWCC_BRIGHT_MAUVE;                                         \
   24: return spritelayout##_PALETTE_NEWCC_BRIGHT_PURPLE;                                        \
   25: return spritelayout##_PALETTE_NEWCC_BRIGHT_ORANGE;                                        \
   26: return spritelayout##_PALETTE_NEWCC_BRIGHT_BROWN;                                         \
   27: return spritelayout##_PALETTE_NEWCC_CLASSIC_BROWN;                                        \
   28: return spritelayout##_PALETTE_NEWCC_CLASSIC_WHITE;                                        \
}                                                                                                \
switch (FEAT_INDUSTRYTILES, PARENT, spritelayout##_select_color, founder) {                      \
    16: return spritelayout##_random_company_color;                                              \
    return spritelayout##_PALETTE_USE_DEFAULT;                                                   \
}

