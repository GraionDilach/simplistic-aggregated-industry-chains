switch (FEAT_INDUSTRIES, SELF, location_candy_chain_no_desert_not_above_snowline, nearby_tile_terrain_type(0, 0)) {
        TILETYPE_DESERT: return string(STR_ERR_NO_DESERT_ONLY);
        TILETYPE_SNOW: return string(STR_ERR_BELOW_SNOWLINE_ONLY);
        location_candy_chain_distance_shop;
}

