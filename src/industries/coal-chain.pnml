switch (FEAT_INDUSTRIES, SELF, location_coal_chain_distance_coal_mine, industry_distance(COAL_MINE_INDEX)) {
        0..24: return string(STR_ERR_LOCATION_COAL_MINE);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_coal_chain_distance_power_plant, industry_distance(POWER_PLANT_INDEX)) {
        0..24: return string(STR_ERR_LOCATION_POWER_PLANT);
        location_coal_chain_distance_coal_mine;
}

item(FEAT_INDUSTRIES, industry_coal_mine, COAL_MINE_INDEX) {
    property {
        substitute: 0;
        override: 0;
        cargo_types: [
            produce_cargo("COAL", 15)
        ];
        prob_map_gen: 8;
        prob_in_game: 3;
        life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, COAL_MINE_INDEX);
        nearby_station_name: string(STR_INDUSTRY_COAL_MINE_STATION_NAME);
    }
    graphics {
       location_check: location_coal_chain_distance_power_plant;
    }
}

