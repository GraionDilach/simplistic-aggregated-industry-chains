switch (FEAT_INDUSTRIES, SELF, location_coal_chain_distance_coal_mine, industry_distance(COAL_MINE_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_COAL_MINE);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_coal_chain_distance_power_plant, industry_distance(POWER_PLANT_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_POWER_PLANT);
        location_coal_chain_distance_coal_mine;
}

item(FEAT_INDUSTRIES, industry_coal_mine, COAL_MINE_INDEX) {
    property {
        substitute: 0;
        override: 0;
        cargo_types: [
            produce_cargo("COAL", 15)
        ];
        prob_map_gen: 8;
        prob_in_game: 3;
        life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, COAL_MINE_INDEX);
        nearby_station_name: string(STR_INDUSTRY_COAL_MINE_STATION_NAME);
    }
    graphics {
       location_check: location_coal_chain_distance_power_plant;
    }
}

item(FEAT_INDUSTRYTILES, power_plant_tile_1) {
    property {
        substitute: 7;
        override: 7;
        accepted_cargos: [];
        special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
    }
}

spritelayout spritelayout_power_plant_tile_2
{
    ground {
        sprite: GROUNDSPRITE_CLEARED;
    }
    building {
        sprite: construction_state == 0 ? 2048 :
                construction_state != 3 ? 2049 : 2050;
    }
    building {
        sprite: 3701 + animation_frame;
        xoffset: 4;
		yoffset: 0;
		zoffset: 34;
        hide_sprite: construction_state != 3;
    }
}

item(FEAT_INDUSTRYTILES, power_plant_tile_2) {
    property {
        substitute: 8;
        override: 8;
        animation_info: [ANIMATION_LOOPING, 8];
        animation_speed: 3;
        accepted_cargos: [[PASS, 1]];
        special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
    }
    graphics {
        default: spritelayout_power_plant_tile_2;
    }
}

item(FEAT_INDUSTRYTILES, power_plant_tile_3) {
    property {
        substitute: 9;
        override: 9;
        accepted_cargos: [];
        special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
    }
}

spritelayout spritelayout_power_plant_tile_4
{
    ground {
        sprite: GROUNDSPRITE_CLEARED;
    }
    building {
        sprite: 2054;
        hide_sprite: construction_state == 0;
    }
    childsprite {
        sprite: 2054 + animation_frame;
        hide_sprite: construction_state != 3 || animation_frame == 0;
    }
}

switch (FEAT_INDUSTRYTILES, SELF, power_plant_tile_4_initiate_sparks, (construction_state == 3) ? 1 : 0) { return;}

switch (FEAT_INDUSTRYTILES, SELF, power_plant_tile_4_initiate_random_sparks, extra_callback_info1 % 64) {
    1: power_plant_tile_4_initiate_sparks;
    return 0;
}

switch (FEAT_INDUSTRYTILES, SELF, power_plant_tile_4_iterate_sparks, animation_frame) {
    1: return 2;
    2: return 3;
    3: return 4;
    4: return 5;
    5: return 6;
    6: return 0;
    return power_plant_tile_4_initiate_random_sparks;
}

switch (FEAT_INDUSTRYTILES, SELF, power_plant_tile_4_anim_control, getbits(extra_callback_info2, 0, 8)) {
    ANIM_TRIGGER_INDTILE_TILE_LOOP: power_plant_tile_4_iterate_sparks;
    ANIM_TRIGGER_INDTILE_RECEIVED_CARGO: power_plant_tile_4_initiate_sparks;
}

item(FEAT_INDUSTRYTILES, power_plant_tile_4) {
    property {
        substitute: 10;
        override: 10;
        accepted_cargos: [];
        animation_info: [ANIMATION_NON_LOOPING, 7];
        animation_speed: 0;
        animation_triggers: bitmask(ANIM_TRIGGER_INDTILE_RECEIVED_CARGO, ANIM_TRIGGER_INDTILE_TILE_LOOP);
        special_flags: bitmask(INDTILE_FLAG_RANDOM_ANIMATION, INDTILE_FLAG_ACCEPT_ALL);
    }
    graphics {
        default: spritelayout_power_plant_tile_4;
        anim_control: power_plant_tile_4_anim_control;
        anim_next_frame: power_plant_tile_4_iterate_sparks;
    }
}

item(FEAT_INDUSTRIES, industry_power_plant, POWER_PLANT_INDEX) {
    property {
        substitute: 1;
        override: 1;
        cargo_types: [
            accept_cargo("COAL"),
            accept_cargo("WSTE")
        ];
        prob_map_gen: 5;
        prob_in_game: 2;
        life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, POWER_PLANT_INDEX);
        nearby_station_name: string(STR_INDUSTRY_POWER_PLANT_STATION_NAME);
    }
    graphics {
       location_check: location_coal_chain_distance_power_plant;
    }
}
