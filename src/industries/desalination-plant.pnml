item(FEAT_INDUSTRYTILES, desalination_plant_tile_pump) {
    property {
        substitute: 39;
        accepted_cargos: [];
    }
    graphics {
        default: desalination_plant_tile_pump_spritelayout;
        foundations: return CB_RESULT_FOUNDATIONS;
        autoslope: return CB_RESULT_AUTOSLOPE;
    }
}

