item(FEAT_INDUSTRIES, industry_desalination_plant, DESALINATION_PLANT_INDEX) {
    property {
        substitute: 21;
        name: string(STR_INDUSTRY_DESALINATION_PLANT_NAME);
        layouts: [desalination_plant_layout_se, desalination_plant_layout_sw, desalination_plant_layout_nw, desalination_plant_layout_ne];
        cargo_types: [
            produce_cargo("WATR", 8),
            produce_cargo("CHEM", 8),
        ];
        prob_map_gen: 4;
        prob_in_game: 3;
        life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, DESALINATION_PLANT_INDEX);
        nearby_station_name: string(STR_INDUSTRY_DESALINATION_PLANT_STATION_NAME);
    }
    graphics {
        colour:	(founder == 16) ? COLOUR_LIGHT_BLUE : founder_colour1;
        location_check: location_desalination_plant_distance_desalination_plant;
    }
}
