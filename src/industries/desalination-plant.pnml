switch (FEAT_INDUSTRYTILES, SELF, desalination_plant_tile_water_check, (nearby_tile_water_class(0, 0) == WATER_CLASS_SEA)) {
    1: return CB_RESULT_LOCATION_ALLOW;
    return CB_RESULT_LOCATION_DISALLOW;
}

