item(FEAT_INDUSTRIES, industry_factory, FACTORY_INDEX) {
    property {
        substitute: 6;
        override: 6;
        layouts: [factory_layout_1, factory_layout_2, factory_layout_3, factory_layout_4];
        cargo_types: [
            accept_cargo("STEL", produce_cargo("GOOD", 1)),
            accept_cargo("RUBR", produce_cargo("GOOD", 1)),
            accept_cargo("GLAS", produce_cargo("GOOD", 1))
        ];
        prob_map_gen: 5;
        prob_in_game: 2;
        life_type: IND_LIFE_TYPE_PROCESSING;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, FACTORY_INDEX);
        nearby_station_name: string(STR_INDUSTRY_FACTORY_STATION_NAME);
    }
    graphics {
        location_check: location_factory_distance_printing_works;
    }
}
