tilelayout farm_layout_1 {
    0, 0: 37;
    0, 1: 37;
    0, 2: 37;
    0, 3: 36;
    1, 0: 37;
    1, 1: farm_tile_1;
    1, 2: farm_tile_2;
    1, 3: farm_tile_3;
    2, 0: 36;
    2, 1: 36;
    2, 2: farm_tile_3;
    2, 3: farm_tile_3;
}

tilelayout farm_layout_2 {
    0, 0: 37;
    0, 1: 37;
    0, 2: 36;
    1, 0: farm_tile_1;
    1, 1: farm_tile_2;
    1, 2: farm_tile_3;
    2, 0: 36;
    2, 1: farm_tile_3;
    2, 2: farm_tile_3;
}

tilelayout farm_layout_3 {
    0, 0: 37;
    0, 1: 36;
    0, 2: 37;
    0, 3: 37;
    1, 0: 36;
    1, 1: farm_tile_3;
    1, 2: farm_tile_3;
    1, 3: 36;
    2, 0: farm_tile_1;
    2, 1: farm_tile_2;
    2, 2: 37;
    2, 3: farm_tile_3;
}

item(FEAT_INDUSTRIES, industry_farm, FARM_INDEX) {
    property {
        substitute: 9;
        override: 9;
        cargo_types: [
            produce_cargo("GRAI", 10),
            produce_cargo("FICR", 10)
        ];
        layouts: [farm_layout_1, farm_layout_2, farm_layout_3];
        random_sound_effects: [];
        prob_map_gen: 9;
        prob_in_game: 4;
        life_type: IND_LIFE_TYPE_ORGANIC;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, FARM_INDEX);
        nearby_station_name: string(STR_INDUSTRY_FARM_STATION_NAME);
        spec_flags: bitmask(IND_FLAG_PLANT_FIELDS_PERIODICALLY, IND_FLAG_PLANT_FIELDS_WHEN_BUILT);
    }
    graphics {
       location_check: location_farm_no_desert;
    }
}
