switch (FEAT_INDUSTRIES, SELF, location_farm_distance_forest, industry_distance(FOREST_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_FOREST);
        CB_RESULT_LOCATION_ALLOW;
}

