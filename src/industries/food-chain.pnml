switch (FEAT_INDUSTRIES, SELF, location_food_chain_distance_farm, industry_distance(FARM_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_FARM);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_food_chain_distance_fruit_plantation, industry_distance(FRUIT_PLANTATION_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_FRUIT_PLANTATION);
        location_food_chain_distance_farm;
}

switch (FEAT_INDUSTRIES, SELF, location_food_chain_distance_food_processing_plant, industry_distance(FOOD_PROCESSING_PLANT_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_FOOD_PROCESSING_PLANT);
        location_food_chain_distance_fruit_plantation;
}

switch (FEAT_INDUSTRIES, SELF, location_food_chain_distance_shop, industry_distance(SHOP_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_SHOP);
        location_food_chain_distance_food_processing_plant;
}

switch (FEAT_INDUSTRIES, SELF, location_food_chain_no_desert, nearby_tile_terrain_type(0, 0)) {
        TILETYPE_DESERT: return string(STR_ERR_NO_DESERT_ONLY);
        location_food_chain_distance_shop;
}

switch (FEAT_INDUSTRIES, SELF, location_food_chain_no_desert_not_above_snowline, nearby_tile_terrain_type(0, 0)) {
        TILETYPE_DESERT: return string(STR_ERR_NO_DESERT_ONLY);
        TILETYPE_SNOW: return string(STR_ERR_BELOW_SNOWLINE_ONLY);
        location_food_chain_distance_shop;
}

