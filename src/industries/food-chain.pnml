item(FEAT_INDUSTRIES, industry_farm, FARM_INDEX) {
    property {
        substitute: 9;
        override: 9;
        cargo_types: [
            produce_cargo("GRAI", 10),
            produce_cargo("LVST", 10)
        ];
        layouts: [farm_layout_1, farm_layout_2, farm_layout_3];
        random_sound_effects: [];
        prob_map_gen: 9;
        prob_in_game: 4;
        life_type: IND_LIFE_TYPE_ORGANIC;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, FARM_INDEX);
        nearby_station_name: string(STR_INDUSTRY_FARM_STATION_NAME);
        spec_flags: bitmask(IND_FLAG_PLANT_FIELDS_PERIODICALLY, IND_FLAG_PLANT_FIELDS_WHEN_BUILT);
    }
    graphics {
       location_check: location_food_chain_no_desert;
    }
}

