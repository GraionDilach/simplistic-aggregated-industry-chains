#define SPRITELAYOUT_food_processing_plant_TILE_1(recolorpalette) \
spritelayout spritelayout_food_processing_plant_tile_1_##recolorpalette \
{ \
    ground { \
        sprite: 2022; \
    } \
    building { \
        sprite: construction_state == 0 ? 2188 : \
                construction_state != 3 ? 2189 : 2190; \
        recolour_mode: RECOLOUR_REMAP; \
        palette: recolorpalette; \
    } \
}

