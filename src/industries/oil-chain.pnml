{ \
    ground { \
        sprite: 1420; \
    } \
    building { \
        sprite: construction_state == 0 ? 2078 : \
                construction_state != 3 ? 2079 : 2080; \
        recolour_mode: RECOLOUR_REMAP; \
        palette: recolorpalette; \
