switch (FEAT_INDUSTRIES, SELF, location_oil_chain_distance_oil_wells, industry_distance(OIL_WELLS_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_OIL_WELLS);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_oil_chain_distance_oil_rig, industry_distance(OIL_RIG_INDEX)) {
