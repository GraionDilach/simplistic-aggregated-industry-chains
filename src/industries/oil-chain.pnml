switch (FEAT_INDUSTRIES, SELF, location_oil_chain_distance_oil_wells, industry_distance(OIL_WELLS_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_OIL_WELLS);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_oil_chain_distance_oil_rig, industry_distance(OIL_RIG_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_OIL_RIG);
        location_oil_chain_distance_oil_wells;
}

switch (FEAT_INDUSTRIES, SELF, location_oil_chain_distance_oil_refinery, industry_distance(OIL_REFINERY_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_REFINERY);
        location_oil_chain_distance_oil_rig;
}

switch (FEAT_INDUSTRIES, SELF, location_oil_chain_distance_shop, industry_distance(SHOP_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_SHOP);
        location_oil_chain_distance_oil_refinery;
}

item(FEAT_INDUSTRIES, industry_oil_wells, OIL_WELLS_INDEX) {
    property {
        substitute: 11;
        override: 11;
        cargo_types: [
            produce_cargo("OIL_", 12),
        ];
        prob_map_gen: 5;
        prob_in_game: 5;
        life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, OIL_WELLS_INDEX);
        nearby_station_name: string(STR_INDUSTRY_OIL_WELLS_STATION_NAME);
        spec_flags: 0;
    }
    graphics {
        location_check: location_oil_chain_distance_shop;
    }
}

item(FEAT_INDUSTRIES, industry_oil_rig, OIL_RIG_INDEX) {
    property {
        substitute: 5;
        override: 5;
        cargo_types: [
            produce_cargo("OIL_", 15),
            produce_cargo("PASS", 2)
        ];
        prob_map_gen: 3;
        prob_in_game: 6;
        life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, OIL_RIG_INDEX);
        nearby_station_name: string(STR_INDUSTRY_OIL_RIG_STATION_NAME);
        spec_flags: bitmask(IND_FLAG_BUILT_ON_WATER, IND_FLAG_AI_CREATES_AIR_AND_SHIP_ROUTES);
    }
    graphics {
        location_check: location_oil_chain_distance_shop;
    }
}

#define SPRITELAYOUT_REFINERY_TILE_1(recolorpalette) \
spritelayout spritelayout_refinery_tile_1_##recolorpalette \
{ \
    ground { \
        sprite: 1420; \
    } \
    building { \
        sprite: construction_state == 0 ? 2078 : \
                construction_state != 3 ? 2079 : 2080; \
        recolour_mode: RECOLOUR_REMAP; \
        palette: recolorpalette; \
    } \
}

