switch (FEAT_INDUSTRIES, SELF, location_tea_chain_distance_tea_factory, industry_distance(TEA_FACTORY_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_TEA_FACTORY);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_tea_chain_distance_teahouse, industry_distance(TEAHOUSE_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_TEAHOUSE);
        location_tea_chain_distance_tea_factory;
}

switch (FEAT_INDUSTRIES, SELF, location_teahouse_distance_tea_factory, industry_distance(TEA_FACTORY_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_TEA_FACTORY);
        location_fizzy_drink_chain_distance_fizzy_drink_factory;
}

switch (FEAT_INDUSTRIES, SELF, location_teahouse_count, industry_town_count(TEAHOUSE_INDEX)) {
        0: location_teahouse_distance_tea_factory;
        return string(STR_ERR_LOCATION_TEAHOUSE);
}

switch (FEAT_INDUSTRIES, PARENT, location_teahouse_count_population, population) {
        0..750: return string(STR_ERR_TOO_SMALL_TOWN);
        return location_teahouse_count;
}

