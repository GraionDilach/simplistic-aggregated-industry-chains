	0, 0: tea_factory_tile_2;
	1, 0: tea_factory_tile_4;
	0, 1: tea_factory_tile_3;
	1, 1: tea_factory_tile_5;
}
tilelayout tea_factory_layout_3 {
	0, 0: tea_factory_tile_3;
	1, 0: tea_factory_tile_1;
	0, 1: tea_factory_tile_2;
	1, 1: tea_factory_tile_4;
}

item(FEAT_INDUSTRIES, industry_tea_factory, TEA_FACTORY_INDEX) {
    property {
        substitute: 6;
        name: string(STR_INDUSTRY_TEA_FACTORY_NAME);
        layouts: [tea_factory_layout_1, tea_factory_layout_2, tea_factory_layout_3];
        cargo_types: [
            accept_cargo("TEAL", produce_cargo("TEAB", 1))
        ];
        prob_map_gen: 5;
        prob_in_game: 2;
        life_type: IND_LIFE_TYPE_PROCESSING;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, TEA_FACTORY_INDEX);
        nearby_station_name: string(STR_INDUSTRY_TEA_FACTORY_STATION_NAME);
    }
    graphics {
        location_check: location_tea_chain_distance_teahouse;
    }
}

