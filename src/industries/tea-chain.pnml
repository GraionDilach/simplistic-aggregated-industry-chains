#define SPRITELAYOUT_tea_factory_TILE_1(recolorpalette) \
spritelayout spritelayout_tea_factory_tile_1_##recolorpalette { \
    ground { \
        sprite: construction_state == 3 ? GROUNDSPRITE_CONCRETE : GROUNDSPRITE_CLEARED; \
    } \
    childsprite { \
        sprite: tea_factory_tile1_ground; \
        always_draw: 1; \
        recolour_mode: RECOLOUR_REMAP; \
        palette: recolorpalette; \
    } \
    building { \
        sprite: tea_factory_tile1_building; \
        recolour_mode: RECOLOUR_REMAP; \
        palette: recolorpalette; \
    } \
}

RECOLOR_SPRITELAYOUTS(SPRITELAYOUT_tea_factory_TILE_1)

INDUSTRYTILE_RECOLOR_BLOCK(spritelayout_tea_factory_tile_1)

item(FEAT_INDUSTRYTILES, tea_factory_tile_1) {
    property {
        substitute: 39;
        accepted_cargos: [];
        special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
    }
    graphics {
        spritelayout_tea_factory_tile_1_select_color;
    }
}

