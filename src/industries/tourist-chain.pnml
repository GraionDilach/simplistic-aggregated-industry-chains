item(FEAT_INDUSTRIES, industry_town_square, TOWN_SQUARE_INDEX) {
    property {
        substitute: 23;
        name: string(STR_INDUSTRY_TOWN_SQUARE_NAME);
        layouts: [town_square_tilelayout1];
        prob_map_gen: 2;
        prob_in_game: 3;
        life_type: IND_LIFE_TYPE_BLACK_HOLE;
        cargo_types: [
            produce_cargo("TOUR", 4),
            accept_cargo("TOUR", produce_cargo("TOUR", 0.5)),
            accept_cargo("GOOD")
        ];
        spec_flags: bitmask(IND_FLAG_ONLY_IN_TOWNS);
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, TOWN_SQUARE_INDEX);
        nearby_station_name: string(STR_INDUSTRY_TOWN_SQUARE_STATION_NAME);
    }
    graphics {
        location_check: location_town_square_count_population;
    }
}
