switch (FEAT_INDUSTRIES, SELF, location_toy_chain_distance_battery_farm, industry_distance(BATTERY_FARM_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_BATTERY_FARM);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_toy_chain_distance_plastic_fountains, industry_distance(PLASTIC_FOUNTAINS_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_PLASTIC_FOUNTAINS);
        location_toy_chain_distance_battery_farm;
}

switch (FEAT_INDUSTRIES, SELF, location_toy_chain_distance_toy_factory, industry_distance(TOY_FACTORY_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_TOY_FACTORY);
        location_toy_chain_distance_plastic_fountains;
}

switch (FEAT_INDUSTRIES, SELF, location_toy_chain_distance_toy_shop, industry_distance(TOY_SHOP_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_TOY_SHOP);
        location_toy_chain_distance_toy_factory;
}

switch (FEAT_INDUSTRIES, SELF, location_toy_shop_count, industry_town_count(TOY_SHOP_INDEX)) {
        0: location_toy_chain_distance_toy_shop;
        return string(STR_ERR_LOCATION_TOY_SHOP);
}

switch (FEAT_INDUSTRIES, PARENT, location_toy_shop_count_population, population) {
        0..750: return string(STR_ERR_TOO_SMALL_TOWN);
        return location_toy_shop_count;
}

if (enable_converted_toyland)
{
    item(FEAT_INDUSTRIES, industry_battery_farm, BATTERY_FARM_INDEX) {
        property {
            substitute: 28;
            override: 28;
            cargo_types: [
                produce_cargo("BATT", 11),
            ];
            prob_map_gen: 4;
            prob_in_game: 3;
            life_type: IND_LIFE_TYPE_ORGANIC;
            map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, BATTERY_FARM_INDEX);
            nearby_station_name: string(STR_INDUSTRY_BATTERY_FARM_STATION_NAME);
        }
        graphics {
           location_check: location_toy_chain_distance_toy_shop;
        }
    }
}

