    1, 0: treasury_tile_4;
}

item(FEAT_INDUSTRIES, industry_treasury, TREASURY_INDEX) {
    property {
        substitute: 16;
        override: 16;
        name: string(STR_INDUSTRY_TREASURY_NAME);
        layouts: [treasury_layout_1, treasury_layout_2];
        cargo_types: [
            accept_cargo("GOLD", produce_cargo("VALU", 1)),
            accept_cargo("DIAM", produce_cargo("VALU", 1)),
            accept_cargo("VALU")
        ];
        prob_map_gen: 6;
        prob_in_game: 7;
        life_type: IND_LIFE_TYPE_BLACK_HOLE;
        spec_flags: bitmask(IND_FLAG_ONLY_IN_TOWNS);
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, TREASURY_INDEX);
        nearby_station_name: string(STR_INDUSTRY_TREASURY_STATION_NAME);
    }
    graphics {
        location_check: location_treasury_count_population;
    }
}
