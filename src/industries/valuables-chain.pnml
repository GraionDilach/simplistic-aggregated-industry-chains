switch (FEAT_INDUSTRIES, SELF, location_valuables_chain_distance_diamond_mine, industry_distance(DIAMOND_MINE_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_DIAMOND_MINE);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_valuables_chain_distance_gold_mine, industry_distance(GOLD_MINE_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_GOLD_MINE);
        location_valuables_chain_distance_diamond_mine;
}

switch (FEAT_INDUSTRIES, SELF, location_valuables_chain_distance_treasury, industry_distance(TREASURY_INDEX)) {
        0..36: return string(STR_ERR_LOCATION_TREASURY);
        location_valuables_chain_distance_gold_mine;
}

switch (FEAT_INDUSTRIES, SELF, location_treasury_count, industry_town_count(TREASURY_INDEX)) {
        0: location_valuables_chain_distance_treasury;
        return string(STR_ERR_LOCATION_TREASURY);
}

switch (FEAT_INDUSTRIES, PARENT, location_treasury_count_population, population) {
        0..750: return string(STR_ERR_LOCATION_TREASURY);
        return location_treasury_count;
}

item(FEAT_INDUSTRIES, industry_diamond_mine, DIAMOND_MINE_INDEX) {
    property {
        substitute: 17;
        override: 17;
        cargo_types: [
            produce_cargo("DIAM", 7)
        ];
        prob_map_gen: 4;
        prob_in_game: 3;
        life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, DIAMOND_MINE_INDEX);
        nearby_station_name: string(STR_INDUSTRY_DIAMOND_MINE_STATION_NAME);
    }
    graphics {
        location_check: location_valuables_chain_distance_treasury;
    }
}

