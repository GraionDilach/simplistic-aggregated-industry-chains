}

switch (FEAT_INDUSTRIES, SELF, location_junkyard_count, industry_town_count(JUNKYARD_INDEX)) {
        0: location_waste_chain_distance_recycling_center;
        return string(STR_ERR_LOCATION_WATER_TOWER);
}

tilelayout junkyard_tilelayout1 {
    0, 0: junkyard_tile_N;
    0, 1: junkyard_tile_E;
    1, 1: junkyard_tile_S;
    1, 0: junkyard_tile_W;
}

spritelayout junkyard_tile_N_spritelayout {
    ground { sprite: 4675; }
    building { sprite: 4103; xoffset: 0; yoffset: -16; }
    building { sprite: 4102; xoffset: -16; yoffset: 0; }
    building { sprite: (construction_state==0 ? 2037 : construction_state==3 ? 2039 : 2038); xoffset: 2; yoffset: 1; }
}

spritelayout junkyard_tile_E_spritelayout {
    ground { sprite: 4675; }
    building { sprite: 4102; xoffset: -16; yoffset: 0; }
    building { sprite: (construction_state==0 ? 2031 : construction_state==3 ? 2033 : 2032); xoffset: 8; yoffset: 4; }
    building { sprite: (construction_state==0 ? 2034 : construction_state==3 ? 2036 : 2035); xoffset: 2; yoffset: 4; }
    building { sprite: 4103; xoffset: 0; yoffset: 0; }
}

spritelayout junkyard_tile_S_spritelayout {
    ground { sprite: 4675; }
    building { sprite: 4103; xoffset: 0; yoffset: 0; }
    building { sprite: 4102; xoffset: 0; yoffset: 0; }
}

spritelayout junkyard_tile_W_spritelayout {
    ground { sprite: 4675; }
    building { sprite: 4103; xoffset: 0; yoffset: -16; }
    building { sprite: (construction_state==0 ? 2037 : construction_state==3 ? 2039 : 2038); xoffset: 2; yoffset: 1; }
    building { sprite: 4102; xoffset: 0; yoffset: 0; }
}

item(FEAT_INDUSTRYTILES, junkyard_tile_N) {
    property {
        substitute: 39;
        special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
    }
    graphics {
        junkyard_tile_N_spritelayout;
    }
}

