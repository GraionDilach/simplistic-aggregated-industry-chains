item(FEAT_INDUSTRIES, industry_junkyard, JUNKYARD_INDEX) {
    property {
        substitute: 30;
        name: string(STR_INDUSTRY_JUNKYARD_NAME);
        layouts: [junkyard_tilelayout1];
        prob_map_gen: 6;
        prob_in_game: 4;
        cargo_types: [
            produce_cargo("WSTE", 8)
        ];
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, JUNKYARD_INDEX);
        life_type: IND_LIFE_TYPE_ORGANIC;
        nearby_station_name: string(STR_INDUSTRY_JUNKYARD_STATION_NAME);
    }
    graphics {
        location_check: location_junkyard_count;
    }
}

