item(FEAT_INDUSTRIES, industry_recycling_center, RECYCLING_CENTER_INDEX) {
    property {
        substitute: 18;
        name: string(STR_INDUSTRY_RECYCLING_CENTER_NAME);
        layouts: [recycling_center_tilelayout1, recycling_center_tilelayout2];
        prob_map_gen: 6;
        prob_in_game: 4;
        cargo_types: [
            accept_cargo("WSTE",
                produce_cargo("PAPR", 0.5),
                produce_cargo("STEL", 0.5)
            ),
        ];
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, RECYCLING_CENTER_INDEX);
        life_type: IND_LIFE_TYPE_PROCESSING;
        nearby_station_name: string(STR_INDUSTRY_RECYCLING_CENTER_STATION_NAME);
    }
    graphics {
        location_check: location_waste_chain_distance_recycling_center;
    }
}
