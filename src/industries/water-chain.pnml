switch (FEAT_INDUSTRIES, SELF, location_water_chain_distance_supply, industry_distance(WATER_SUPPLY_INDEX)) {
        0..24: return string(STR_ERR_LOCATION_WATER_SUPPLY);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_water_chain_distance_tower, industry_distance(WATER_TOWER_INDEX)) {
        0..24: return string(STR_ERR_LOCATION_WATER_TOWER);
        location_water_chain_distance_supply;
}

switch (FEAT_INDUSTRIES, SELF, location_water_tower_count, industry_town_count(WATER_TOWER_INDEX)) {
        0: location_water_chain_distance_tower;
        return string(STR_ERR_LOCATION_WATER_TOWER);
}

#define SPRITELAYOUT_water_supply_TILE_1(recolorpalette) \
spritelayout spritelayout_water_supply_tile_1_##recolorpalette \
{ \
    ground { \
        sprite: construction_state == 0 ? GROUNDSPRITE_CLEARED \
            : terrain_type == TILETYPE_SNOW ? GROUNDSPRITE_SNOW \
                : terrain_type == TILETYPE_DESERT ? GROUNDSPRITE_DESERT \
                    : GROUNDSPRITE_NORMAL; \
    } \
    building { \
        sprite: construction_state == 0 ? 2347 : \
                construction_state != 3 ? 2348 : 2349; \
        recolour_mode: RECOLOUR_REMAP; \
        palette: recolorpalette; \
    } \
}

RECOLOR_SPRITELAYOUTS(SPRITELAYOUT_water_supply_TILE_1)

