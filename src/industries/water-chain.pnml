#define SPRITELAYOUT_water_tower_TILE_1(recolorpalette) \
spritelayout spritelayout_water_tower_tile_1_##recolorpalette \
{ \
    ground { \
        sprite: construction_state < 2 ? GROUNDSPRITE_CLEARED \
            : (town_zone != TOWNZONE_EDGE && town_zone != TOWNZONE_OUTSKIRT) ? GROUNDSPRITE_CONCRETE \
            : terrain_type == TILETYPE_SNOW ? GROUNDSPRITE_SNOW \
            : terrain_type == TILETYPE_DESERT ? GROUNDSPRITE_DESERT : GROUNDSPRITE_NORMAL; \
    } \
    building { \
        sprite: construction_state == 0 ? 2344 : \
                construction_state != 3 ? 2345 : 2346; \
        recolour_mode: RECOLOUR_REMAP; \
        palette: recolorpalette; \
    } \
}

