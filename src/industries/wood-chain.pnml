#define SPRITELAYOUT_PRINTING_WORKS_TILE_1(recolorpalette) \
spritelayout spritelayout_printing_works_tile_1_##recolorpalette \
{ \
    ground { \
        sprite: 3924; \
    } \
    building { \
        sprite: construction_state == 0 ? 2161 : \
                construction_state != 3 ? 2165 : 2169; \
        recolour_mode: RECOLOUR_REMAP; \
        palette: recolorpalette; \
    } \
}

RECOLOR_SPRITELAYOUTS(SPRITELAYOUT_PRINTING_WORKS_TILE_1)

