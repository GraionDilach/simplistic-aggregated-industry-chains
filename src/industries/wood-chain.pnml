    building { sprite: tree_base_sprite; xoffset: 2; yoffset: 10; }
    building { sprite: tree_base_sprite; xoffset: 10; yoffset: 10; }
    building { sprite: tree_base_sprite; xoffset: 2; yoffset: 2; }
}

