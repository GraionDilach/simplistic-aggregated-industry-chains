item(FEAT_INDUSTRIES, industry_forest, FOREST_INDEX) {
    property {
        substitute: 3;
        override: 3;
        layouts: [forest_layout_1, forest_layout_2];
        cargo_types: [
            produce_cargo("WOOD", 13)
        ];
        prob_map_gen: 5;
        prob_in_game: 4;
        life_type: IND_LIFE_TYPE_ORGANIC;
        map_colour: ARRAY_EVAL(INDUSTRY_COLOR_INDEX, FOREST_INDEX);
        nearby_station_name: string(STR_INDUSTRY_FOREST_STATION_NAME);
    }
    graphics {
       location_check: location_wood_chain_forest_no_desert;
    }
}

