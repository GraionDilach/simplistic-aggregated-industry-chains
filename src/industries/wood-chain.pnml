switch (FEAT_INDUSTRIES, SELF, location_wood_chain_distance_forest, industry_distance(FOREST_INDEX)) {
        0..24: return string(STR_ERR_LOCATION_FOREST);
        CB_RESULT_LOCATION_ALLOW;
}

switch (FEAT_INDUSTRIES, SELF, location_wood_chain_distance_lumber_mill, industry_distance(LUMBER_MILL_INDEX)) {
        0..24: return string(STR_ERR_LOCATION_LUMBER_MILL);
        location_wood_chain_distance_forest;
}

switch (FEAT_INDUSTRIES, SELF, location_wood_chain_distance_paper_mill, industry_distance(PAPER_MILL_INDEX)) {
        0..24: return string(STR_ERR_LOCATION_PAPER_MILL);
        location_wood_chain_distance_lumber_mill;
}

switch (FEAT_INDUSTRIES, SELF, location_wood_chain_distance_printing_works, industry_distance(PRINTING_WORKS_INDEX)) {
        0..24: return string(STR_ERR_LOCATION_PRINTING_WORKS);
        location_wood_chain_distance_paper_mill;
}

switch (FEAT_INDUSTRIES, SELF, location_wood_chain_forest_no_desert, nearby_tile_terrain_type(0, 0)) {
        TILETYPE_DESERT: return string(STR_ERR_NO_DESERT_ONLY);
        location_wood_chain_distance_printing_works;
}

// define default_tree_base 1709
// define ogfxtrees_tree_base 1716
// define stolentrees_tree_base 1709

// define default_tree_base_tropical 1870
// define ogfxtrees_tree_base_tropical 1870
// define stolentrees_tree_base_tropical 1870

tree_base_sprite = (climate == CLIMATE_TROPICAL) ? 1870 : 1709;

/* OpenGFX+ Trees uses different tree sprites. Choose another
 * one which looks better as forest tree sprite
 */
if (grf_future_status("\46\72\78\06")) {
    tree_base_sprite = (climate == CLIMATE_TROPICAL) ? 1870 : 1716;
}

/* Stolen Trees also looks better with another sprite */
if (grf_future_status("\4D\66\6F\01")) {
    tree_base_sprite = (climate == CLIMATE_TROPICAL) ? 1870 : 1709;
}

spritelayout forest_tile_1_animation_1_normal {
    ground   { sprite: GROUNDSPRITE_NORMAL; }
    building { sprite: tree_base_sprite+3; xoffset: 10; yoffset: 2; }
    building { sprite: tree_base_sprite+3; xoffset: 6; yoffset: 6; }
    building { sprite: tree_base_sprite+3; xoffset: 2; yoffset: 10; }
    building { sprite: tree_base_sprite+3; xoffset: 10; yoffset: 10; }
    building { sprite: tree_base_sprite+3; xoffset: 2; yoffset: 2; }
}

spritelayout forest_tile_1_animation_2_normal {
    ground   { sprite: GROUNDSPRITE_NORMAL; }
    building { sprite: 2076; }
}

